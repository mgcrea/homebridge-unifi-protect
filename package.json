{
  "name": "@mgcrea/homebridge-unifi-protect",
  "displayName": "UniFi Protect",
  "version": "0.3.0",
  "description": "Homebridge plugin for UniFi Protect cameras, doorbells, sensors and lights, with live streaming and HomeKit Secure Video",
  "author": "Olivier Louvignes <olivier@mgcrea.io>",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/mgcrea/homebridge-unifi-protect.git"
  },
  "homepage": "https://github.com/mgcrea/homebridge-unifi-protect#readme",
  "bugs": "https://github.com/mgcrea/homebridge-unifi-protect/issues",
  "license": "MIT",
  "publishConfig": {
    "access": "public"
  },
  "type": "module",
  "main": "./dist/index.mjs",
  "types": "./dist/index.d.mts",
  "exports": {
    ".": {
      "types": "./dist/index.d.mts",
      "default": "./dist/index.mjs"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "config.schema.json"
  ],
  "imports": {
    "#*": "./src/*.ts"
  },
  "keywords": [
    "homebridge-plugin",
    "homebridge",
    "homekit",
    "unifi",
    "unifi-protect",
    "ubiquiti",
    "protect",
    "camera",
    "doorbell",
    "hksv"
  ],
  "engines": {
    "node": "^22 || ^24 || ^26",
    "homebridge": "^2.0.0"
  },
  "scripts": {
    "build": "tsdown",
    "dev": "tsdown --watch",
    "lint": "oxlint src/ test/ scripts/",
    "lint:fix": "oxlint --fix src/ test/ scripts/",
    "format": "oxfmt --write src/ test/ scripts/",
    "format:check": "oxfmt --check src/ test/ scripts/",
    "check": "tsc --noEmit",
    "spec": "vitest --run",
    "coverage": "vitest --run --coverage",
    "watch": "vitest",
    "diagnose": "tsx scripts/diagnose.ts",
    "dev:link": "ln -sfn ../../../unifi-protect-client node_modules/@mgcrea/unifi-protect",
    "dev:homebridge": "homebridge -D -U ./.homebridge -P . --strict-plugin-resolution",
    "test": "pnpm run lint && pnpm run check && pnpm run spec && pnpm run format:check",
    "release": "release-it",
    "prepublishOnly": "pnpm run test && pnpm run build"
  },
  "dependencies": {
    "@mgcrea/unifi-protect": "^0.2.0",
    "zod": "^4.5.4"
  },
  "devDependencies": {
    "@tsconfig/node-lts": "^24.0.1",
    "@tsconfig/strictest": "^2.0.8",
    "@types/node": "^22",
    "@vitest/coverage-v8": "^4.1.11",
    "homebridge": "^2.4.0",
    "msw": "^2.15.0",
    "oxfmt": "^0.65.0",
    "oxlint": "^1.80.0",
    "release-it": "^21.0.2",
    "tsdown": "^0.22.14",
    "tsx": "^4.23.13",
    "typescript": "^7.0.2",
    "vitest": "^4.1.11"
  },
  "packageManager": "pnpm@11.25.0"
}
